# Hedera JSON-RPC endpoint used when forking the local chain (testnet default).
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Don't fill manually. Run `npm run hardhat:account:generate` or `npm run hardhat:account:import`.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# Oracle (optional; defaults in config/oracle.ts)
# PYTH_CONTRACT_ADDRESS=0xA2aa501b19aff244D90cc15a4Cf739D2725B5729
# PYTH_PRICE_FEED_ID=0x3728e591097635310e6341af53db8b7ee42da9b3a8d918f9463ce9cca886dfbd
# PYTH_MAX_CONFIDENCE_BPS=200
# PYTH_HERMES_URL=https://hermes.pyth.network

# Vault band, 8 decimals (optional; Hedera default $0.01–$1.00, 60 s)
# VAULT_MIN_PRICE=1000000
# VAULT_MAX_PRICE=100000000
# VAULT_MAX_STALENESS=60

# HTK amount used by `npm run hardhat:e2e:testnet`
# E2E_AMOUNT=10
