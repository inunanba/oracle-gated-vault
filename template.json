{
  "name": "oracle-gated-vault",
  "description": "ERC-20 vault on Hedera gated by a live Pyth price feed: pull a signed price from Hermes, verify it on-chain, deposit or withdraw only while the price is fresh and in band.",
  "version": "1.0.0",
  "create-scaffold-hbar": {
    "capabilities": {
      "frontend": ["nextjs-app"],
      "solidityFramework": ["hardhat"],
      "packageManager": ["npm"]
    },
    "defaults": {
      "frontend": "nextjs-app",
      "solidityFramework": "hardhat",
      "packageManager": "npm"
    },
    "requirements": {
      "node": ">=20.18.3"
    },
    "outro": {
      "sections": [
        {
          "title": "Try it (no keys needed)",
          "steps": [
            { "label": "Unit tests", "command": "npm run hardhat:test" },
            { "label": "Frontend (talks to the public testnet vault)", "command": "npm run next:dev" },
            { "url": "http://localhost:3000/vault" }
          ]
        },
        {
          "title": "Deploy your own on Hedera testnet",
          "steps": [
            { "label": "Create a deployer key", "command": "npm run hardhat:account:generate" },
            { "label": "Fund its EVM address", "url": "https://portal.hedera.com/faucet" },
            { "label": "Deploy", "command": "npm run hardhat:deploy -- --network hederaTestnet" },
            { "label": "Live deposit/withdraw with Pyth updates", "command": "npm run hardhat:e2e:testnet" },
            { "text": "README.md explains the pull-oracle flow; AGENTS.md briefs coding agents." }
          ]
        }
      ]
    }
  }
}
